<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="64dp"
    android:paddingRight="64dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:fontFamily="sans-serif-medium"
        android:paddingBottom="18dp" />

    <!-- Carte RAM facon capture.png -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_ram"
            style="@style/CardTitle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginRight="18dp">

                <com.aia.ramcleaner.GaugeView
                    android:id="@+id/gaugeTotal"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mem_total"
                    style="@style/GaugeLabel" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginLeft="18dp">

                <com.aia.ramcleaner.GaugeView
                    android:id="@+id/gaugeUsage"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mem_usage"
                    style="@style/GaugeLabel" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Pourcentage d'utilisation, bien visible -->
    <TextView
        android:id="@+id/pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dash_pct"
        android:textColor="@color/accent"
        android:textSize="44sp"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="18dp" />

    <TextView
        android:id="@+id/sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:gravity="center"
        android:minHeight="22dp"
        android:paddingTop="6dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/btnClean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clean"
            android:layout_marginRight="16dp"
            style="@style/Btn" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_apps"
            style="@style/Btn" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_ram"
        android:layout_marginTop="12dp"
        style="@style/Btn" />
</LinearLayout>
